# Which wallet to use (default ~/.tollkit-wallet; create one with: npx tollkit-wallet init)
# TOLLKIT_WALLET_HOME=/path/to/wallet
# A file holding the wallet password (safer than putting the password itself here)
TOLLKIT_WALLET_PASSWORD_FILE=/path/to/password.txt
# paper = pretend money at live prices (default); live = real trades
BOT_MODE=paper
